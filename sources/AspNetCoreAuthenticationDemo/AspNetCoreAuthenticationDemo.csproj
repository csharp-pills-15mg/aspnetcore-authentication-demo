<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>DustInTheWind.$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>DustInTheWind.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.16" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
		<PackageReference Include="RequestR" Version="2.2.0" />
		<PackageReference Include="RequestR.Extensions.Microsoft.DependencyInjection" Version="2.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AspNetCoreAuthenticationDemo.Application\AspNetCoreAuthenticationDemo.Application.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\AspNetCoreAuthenticationDemo.Presentation\AspNetCoreAuthenticationDemo.Presentation.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\AspNetCoreAuthenticationDemo.Security\AspNetCoreAuthenticationDemo.Security.csproj" PrivateAssets="All" />
	</ItemGroup>

</Project>
